APP_NAME="Garage Mécano D-CLIC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://garage-guetaba.saeicubetech.com
GARAGE_ADDRESS="Lomé, Togo"
APP_TIMEZONE=Africa/Lome

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saeicubetech_garage
DB_USERNAME=saeicubetech_garage
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
